ARG OCR_RUNTIME_IMAGE=opencodereview-server:latest
FROM rust:1.98.1-bookworm AS build
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
COPY Cargo.toml Cargo.lock ./
COPY backend ./backend
COPY assets ./assets
ARG CARGO_TARGET_CACHE=ocr-cargo-target
# Cargo reads these from the environment. Builds keep two jobs and full optimization; the CI
# smoke sets more jobs and opt-level 0, since it checks the sandbox, not speed.
ARG CARGO_BUILD_JOBS=2
ARG CARGO_PROFILE_RELEASE_OPT_LEVEL
RUN --mount=type=cache,id=ocr-cargo-registry,target=/usr/local/cargo/registry,sharing=locked --mount=type=cache,id=${CARGO_TARGET_CACHE},target=/app/target,sharing=locked cargo build --locked --release --bin ocr-sandbox && cp /app/target/release/ocr-sandbox /usr/local/bin/ocr-sandbox

FROM ${OCR_RUNTIME_IMAGE}
RUN chmod -R a+rX /opt/claude /opt/codex /opt/grok
COPY --from=build /usr/local/bin/ocr-sandbox /usr/local/bin/ocr-sandbox
WORKDIR /runner
ENTRYPOINT ["ocr-sandbox"]
CMD ["runner"]
