{
  "name": "opencodereview",
  "version": "0.2.0",
  "description": "Self-hosted AI code review for GitLab Self-Hosted merge requests.",
  "license": "PolyForm-Small-Business-1.0.0",
  "author": "BRIDG LABS LTDA (https://github.com/BridgLabs)",
  "homepage": "https://github.com/BridgLabs/opencodereview#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BridgLabs/opencodereview.git"
  },
  "bugs": {
    "url": "https://github.com/BridgLabs/opencodereview/issues"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "dev": "vite",
    "dev:web": "VITE_DEV_PORT=1421 vite --host 0.0.0.0",
    "debug:web": "node scripts/dev-web-docker.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:file-size": "node scripts/check-file-sizes.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:staged": "biome check --write --staged --files-ignore-unknown=true --no-errors-on-unmatched",
    "knip": "knip",
    "changelog:check": "node scripts/changelog.mjs check",
    "changelog:release": "node scripts/changelog.mjs release",
    "site:build": "node scripts/site/build.mjs",
    "site:images": "node scripts/og/render.mjs && node scripts/site/build.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-code-block": "3.32.2",
    "@tiptap/extension-list": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/markdown": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "@xyflow/react": "12.12.0",
    "lucide-react": "^1.65.0",
    "nuqs": "^2.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-force-graph-2d": "^1.29.2",
    "react-is": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "26.1.0",
    "knip": "^5.88.1",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
